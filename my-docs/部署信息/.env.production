# OpenClaw 生产环境配置
# 部署目录: /opt/mtbot
# 生成时间: 2026-02-22
# 密码源: my-docs/部署信息/.env

# ==================== 应用配置 ====================
NODE_ENV=production
APP_NAME=OpenClaw

# ==================== 数据库配置 ====================
POSTGRES_USER=openclaw_admin
POSTGRES_PASSWORD=Oc@2026!Pg#Secure
POSTGRES_DB=openclaw_prod
DATABASE_URL=postgresql://openclaw_admin:Oc%402026!Pg%23Secure@localhost:22001/openclaw_prod
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=300000
DATABASE_SSL=false

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=22002
REDIS_PASSWORD=Oc@2026!Rd#Secure
REDIS_URL=redis://:Oc%402026!Rd%23Secure@localhost:22002/0

# ==================== MinIO 配置 ====================
MINIO_ACCESS_KEY=openclaw_minio
MINIO_SECRET_KEY=Oc@2026!Mn#Secure
MINIO_ENDPOINT=localhost
MINIO_PORT=22003
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ==================== Gateway 配置 ====================
GATEWAY_TOKEN=8653d1292c550dfa3950fb35cba85f6d4c35dfd5fe91bfef
GATEWAY_PORT=22189
BRIDGE_PORT=22190
GATEWAY_BIND=lan

# ==================== API Server 配置 ====================
API_SERVER_PORT=22300

# ==================== JWT 配置 ====================
JWT_SECRET=Oc@2026!JwtSecret#32CharMinimumRequired
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==================== Milvus 配置 ====================
MILVUS_ADDRESS=localhost:22005
MILVUS_TOKEN=
MILVUS_DATABASE=default

# ==================== Neo4j 配置 ====================
NEO4J_URI=bolt://localhost:22008
NEO4J_USER=neo4j
NEO4J_PASSWORD=Oc@2026!N4j#Secure

# ==================== RabbitMQ 配置 ====================
RABBITMQ_URL=amqp://openclaw_mq:Oc%402026!Mq%23Secure@localhost:22009/openclaw

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json
