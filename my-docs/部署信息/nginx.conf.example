# OpenClaw Nginx 反向代理配置示例
#
# 使用方法:
#   1. 复制此文件到 /etc/nginx/sites-available/openclaw
#   2. 修改域名、SSL 证书路径等配置
#   3. 创建符号链接: sudo ln -s /etc/nginx/sites-available/openclaw /etc/nginx/sites-enabled/
#   4. 测试配置: sudo nginx -t
#   5. 重新加载: sudo systemctl reload nginx

# ==================== HTTP 服务器（重定向到 HTTPS）====================
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com;

    # 重定向所有 HTTP 请求到 HTTPS
    return 301 https://$server_name$request_uri;
}

# ==================== HTTPS 服务器 ====================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.com www.your-domain.com;

    # ==================== SSL 证书配置 ====================
    # 使用部署信息目录下的证书文件
    # 证书文件位置: my-docs/部署信息/mtbot.top_nginx/
    ssl_certificate /opt/mtbot/mtbot.top_nginx/mtbot.top.crt;
    ssl_certificate_key /opt/mtbot/mtbot.top_nginx/mtbot.top.key;

    # SSL 配置（推荐配置）
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 安全头
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # 日志配置
    access_log /var/log/nginx/openclaw-access.log;
    error_log /var/log/nginx/openclaw-error.log;

    # 客户端最大上传大小
    client_max_body_size 50M;

    # ==================== 官方网站 (Website) ====================
    location / {
        root /var/www/openclaw-website;
        index index.html;
        try_files $uri $uri/ /index.html;

        # 缓存静态资源
        location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # ==================== 管理后台 (Admin Console) ====================
    location /admin {
        alias /var/www/openclaw-admin;
        index index.html;
        try_files $uri $uri/ /admin/index.html;

        # 缓存静态资源
        location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # ==================== API Server 代理 ====================
    location /api {
        proxy_pass http://127.0.0.1:22300;
        proxy_http_version 1.1;

        # 请求头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 超时配置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # 缓冲配置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }

    # ==================== Gateway WebSocket 代理 ====================
    location /ws {
        proxy_pass http://127.0.0.1:22189;
        proxy_http_version 1.1;

        # WebSocket 升级
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 请求头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 超时配置（较长）
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
    }

    # ==================== Gateway HTTP API 代理 ====================
    location /gateway {
        proxy_pass http://127.0.0.1:22189;
        proxy_http_version 1.1;

        # 请求头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 超时配置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ==================== 健康检查端点 ====================
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

# ==================== 直接端口访问配置（可选）====================
# 如果不需要域名，可以直接通过端口访问

# Website (端口 22888)
server {
    listen 22888;
    server_name _;

    root /var/www/openclaw-website;
    index index.html;
    try_files $uri $uri/ /index.html;

    access_log /var/log/nginx/website-access.log;
    error_log /var/log/nginx/website-error.log;
}

# Admin Console (端口 22176)
server {
    listen 22176;
    server_name _;

    root /var/www/openclaw-admin;
    index index.html;
    try_files $uri $uri/ /index.html;

    # API 代理
    location /api {
        proxy_pass http://127.0.0.1:22300;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket 代理
    location /ws {
        proxy_pass http://127.0.0.1:22189;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
    }

    access_log /var/log/nginx/admin-access.log;
    error_log /var/log/nginx/admin-error.log;
}

