# MtBot 生产环境配置模板
#
# 使用说明:
#   1. 复制此文件为 .env.production
#   2. 修改所有标记为 "CHANGE_ME" 的值
#   3. 确保所有密码使用强密码
#   4. 不要将此文件提交到版本控制系统
#

# ==================== 应用配置 ====================

# 环境标识
NODE_ENV=production

# 应用名称
APP_NAME=MtBot

# 应用版本
APP_VERSION=2026.1.30

# ==================== 数据库配置 ====================

# PostgreSQL 用户名
POSTGRES_USER=mtbot_admin

# PostgreSQL 密码（重要！请修改）
POSTGRES_PASSWORD=CHANGE_ME_Oc@2026!Pg#Secure

# PostgreSQL 数据库名
POSTGRES_DB=mtbot_prod

# PostgreSQL 端口
POSTGRES_PORT=22001

# 数据库连接 URL（本地开发）
DATABASE_URL=postgresql://mtbot_admin:CHANGE_ME_Oc@2026!Pg#Secure@localhost:22001/mtbot_prod

# 数据库连接池
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==================== Redis 配置 ====================

# Redis 主机
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=22002

# Redis 密码（重要！请修改）
REDIS_PASSWORD=CHANGE_ME_Oc@2026!Rd#Secure

# Redis 数据库索引
REDIS_DB=0

# Redis 连接池
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# ==================== MinIO 配置 ====================

# MinIO 访问密钥（重要！请修改）
MINIO_ACCESS_KEY=mtbot_minio

# MinIO 密钥（重要！请修改）
MINIO_SECRET_KEY=CHANGE_ME_Oc@2026!Mn#Secure

# MinIO 端点
MINIO_ENDPOINT=localhost

# MinIO API 端口
MINIO_API_PORT=22003

# MinIO 控制台端口
MINIO_CONSOLE_PORT=22004

# MinIO 端口（内部使用）
MINIO_PORT=9000

# 是否使用 SSL
MINIO_USE_SSL=false

# MinIO 存储桶名称
MINIO_BUCKET_DOCUMENTS=mtbot-documents
MINIO_BUCKET_MEDIA=mtbot-media
MINIO_BUCKET_TEMP=mtbot-temp
MINIO_BUCKET_EXPORTS=mtbot-exports
MINIO_BUCKET_SKILLS=mtbot-skills

# ==================== API Server 配置 ====================

# API Server 监听主机
API_SERVER_HOST=0.0.0.0

# API Server 监听端口
API_SERVER_PORT=3000

# API Server 公网地址（用于生成链接，请修改为实际域名）
API_SERVER_PUBLIC_URL=http://your-domain.com:3000

# CORS 允许的源（多个用逗号分隔）
API_CORS_ORIGINS=http://localhost:3001,http://your-domain.com:3001

# ==================== Gateway 配置 ====================

# Gateway 监听主机
GATEWAY_HOST=0.0.0.0

# Gateway 监听端口
GATEWAY_PORT=18789

# Gateway 桥接端口
BRIDGE_PORT=18790

# Gateway 绑定模式 (loopback, lan, wan)
GATEWAY_BIND=lan

# Gateway 认证令牌（重要！请修改为随机字符串）
GATEWAY_TOKEN=CHANGE_ME_your-secure-gateway-token-min-32-chars

# Gateway 公网地址（WebSocket 连接地址）
GATEWAY_PUBLIC_URL=ws://your-domain.com:18789

# ==================== JWT 配置 ====================

# JWT 密钥（重要！请修改为随机字符串，至少 32 字符）
JWT_SECRET=CHANGE_ME_your-super-secret-jwt-key-min-32-chars-random-string

# JWT 访问令牌过期时间
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# JWT 刷新令牌过期时间
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ==================== 管理员配置 ====================

# 初始管理员用户名
ADMIN_USERNAME=admin

# 初始管理员密码（重要！请修改）
ADMIN_PASSWORD=CHANGE_ME_Admin@2026!Secure

# 初始管理员邮箱
ADMIN_EMAIL=admin@mtbot.top

# ==================== Web Admin 配置 ====================

# Web Admin 端口
WEB_ADMIN_PORT=3001

# ==================== 日志配置 ====================

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 日志输出格式 (json, pretty)
LOG_FORMAT=json

# 日志文件路径
LOG_FILE_PATH=./logs/mtbot.log

# 日志文件最大大小（MB）
LOG_MAX_SIZE=10

# 日志文件最大数量
LOG_MAX_FILES=7

# ==================== 安全配置 ====================

# 速率限制窗口时间（毫秒）
RATE_LIMIT_WINDOW_MS=60000

# 速率限制最大请求数
RATE_LIMIT_MAX_REQUESTS=100

# 会话密钥（重要！请修改）
SESSION_SECRET=CHANGE_ME_your-session-secret-min-32-chars

# 会话最大存活时间（毫秒）
SESSION_MAX_AGE=86400000

# CSRF 保护
CSRF_ENABLED=true

# ==================== 第三方服务 (可选) ====================

# Claude AI Session Key
CLAUDE_AI_SESSION_KEY=

# Claude Web Session Key
CLAUDE_WEB_SESSION_KEY=

# Claude Web Cookie
CLAUDE_WEB_COOKIE=

# OpenAI API Key
OPENAI_API_KEY=

# ==================== 监控配置 (可选) ====================

# 是否启用 Prometheus 监控
PROMETHEUS_ENABLED=false

# Prometheus 端口
PROMETHEUS_PORT=22011

# 是否启用 Grafana
GRAFANA_ENABLED=false

# Grafana 端口
GRAFANA_PORT=22012

# Grafana 管理员用户名
GRAFANA_USER=grafana_admin

# Grafana 管理员密码
GRAFANA_PASSWORD=CHANGE_ME_Oc@2026!Gf#Secure

# ==================== 知识图谱配置 (可选) ====================

# Neo4j 用户名
NEO4J_USER=neo4j_admin

# Neo4j 密码
NEO4J_PASSWORD=CHANGE_ME_Oc@2026!N4j#Secure

# Neo4j HTTP 端口
NEO4J_HTTP_PORT=22007

# Neo4j Bolt 端口
NEO4J_BOLT_PORT=22008

# Milvus 端口
MILVUS_PORT=22005

# Milvus gRPC 端口
MILVUS_GRPC_PORT=22006

# ==================== 消息队列配置 (可选) ====================

# RabbitMQ 用户名
RABBITMQ_USER=mtbot_mq

# RabbitMQ 密码
RABBITMQ_PASSWORD=CHANGE_ME_Oc@2026!Mq#Secure

# RabbitMQ 端口
RABBITMQ_PORT=22009

# RabbitMQ 管理界面端口
RABBITMQ_MANAGEMENT_PORT=22010

# ==================== 开发工具配置 (可选) ====================

# pgAdmin 邮箱
PGADMIN_EMAIL=admin@mtbot.top

# pgAdmin 密码
PGADMIN_PASSWORD=CHANGE_ME_Oc@2026!Pga#Secure

# pgAdmin 端口
PGADMIN_PORT=22014

# Redis Commander 端口
REDIS_COMMANDER_PORT=22015

# Milvus Attu 端口
ATTU_PORT=22016

# ==================== Docker 配置 ====================

# MtBot 镜像名称
MTBOT_IMAGE=mtbot:latest

# MtBot 配置目录
MTBOT_CONFIG_DIR=./docker-data/mtbot-config

# MtBot 工作空间目录
MTBOT_WORKSPACE_DIR=./docker-data/mtbot-workspace
